APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
DEFAULT_LANG = zh-cn

[DB]
DB_DRIVER = mysql
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = mall
DB_USER = root
DB_PASS =
DB_CHARSET = utf8mb4
DB_PREFIX = tp_

[CACHE]
CACHE_DRIVER = file
CACHE_TIME = 3600

[SESSION]
SESSION_EXPIRE = 7200

[JWT]
JWT_SECRET = your_jwt_secret_key_here
JWT_EXPIRE = 7200

[RATE]
RATE_LIMIT = 60
RATE_WINDOW = 60